<?xml version="1.0" encoding="utf-8"?>
<!--
    Bottom sheet style — shown when user taps the bottom "Genesis" bar
    Used as a full BottomSheetDialogFragment
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_background"
    android:orientation="vertical">

    <!-- Handle bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="16dp"
        android:background="@color/card_border"
        android:backgroundTint="@color/text_hint" />

    <!-- Tab row: Books | Chapters | Verses -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayoutPicker"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:tabBackground="@android:color/transparent"
        app:tabGravity="fill"
        app:tabMode="fixed"
        app:tabIndicatorColor="@color/gold_primary"
        app:tabSelectedTextColor="@color/text_primary"
        app:tabTextColor="@color/text_hint"
        app:tabTextAppearance="@style/TabTextMedium">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Book" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chapter" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Verse" />

    </com.google.android.material.tabs.TabLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/card_border" />

    <!-- Pager — each tab shows its own RecyclerView -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPagerPicker"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>