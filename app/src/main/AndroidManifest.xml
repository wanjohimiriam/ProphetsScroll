<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.prophets_scroll">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Prophets_Scroll">

        <!-- LAUNCHER → Splash screen (entry point) -->
        <activity
            android:name=".onboard.SplashActivity"
            android:theme="@style/Theme.Prophets_Scroll"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Onboarding flow -->
        <activity
            android:name=".onboard.OnboardingActivity"
            android:theme="@style/Theme.Prophets_Scroll"
            android:exported="false" />

        <activity
            android:name=".onboard.PersonalizationStep1Activity"
            android:theme="@style/Theme.Prophets_Scroll" />

        <activity
            android:name=".onboard.PersonalizationStep2Activity"
            android:theme="@style/Theme.Prophets_Scroll" />

        <activity
            android:name=".onboard.SetupCompleteActivity"
            android:theme="@style/Theme.Prophets_Scroll" />

        <!-- Auth screens -->
        <activity
            android:name=".auth.SignUpActivity"
            android:theme="@style/Theme.Prophets_Scroll" />

        <activity
            android:name=".auth.SignInActivity"
            android:theme="@style/Theme.Prophets_Scroll" />

        <!-- Main app -->
        <activity
            android:name=".MainActivity"
            android:theme="@style/Theme.Prophets_Scroll" />

        <activity
            android:name=".home.DevotionalsActivity"
            android:theme="@style/Theme.Prophets_Scroll" />

        <activity
            android:name=".home.SearchActivity"
            android:theme="@style/Theme.Prophets_Scroll" />
        <activity
            android:name=".home.DevotionalDetailActivity"
            android:theme="@style/Theme.Prophets_Scroll" />

        <activity
            android:name=".home.CommentsActivity"
            android:theme="@style/Theme.Prophets_Scroll" />

        <activity
            android:name=".bible.BibleActivity"
            android:theme="@style/Theme.Prophets_Scroll" />

        <activity
            android:name=".bible.BibleReaderActivity"
            android:theme="@style/Theme.Prophets_Scroll" />

        <activity
            android:name=".settings.SettingsActivity"
            android:theme="@style/Theme.Prophets_Scroll" />

    </application>

</manifest>