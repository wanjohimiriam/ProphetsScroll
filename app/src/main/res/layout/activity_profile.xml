<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/home_background">

    <!-- ══════════════ TOP BAR ══════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:background="@color/home_background">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            app:srcCompat="@drawable/ic_baseline_arrow_back_24"
            app:tint="@color/text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="@string/profile_title"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/card_border" />

    <!-- ══════════════ SCROLLABLE CONTENT ══════════════ -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <!-- ── Header banner ── -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_profile_gradient">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingTop="28dp"
                    android:paddingBottom="24dp"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp">

                    <FrameLayout
                        android:layout_width="88dp"
                        android:layout_height="88dp">

                        <TextView
                            android:id="@+id/tvAvatarInitials"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_avatar_circle"
                            android:gravity="center"
                            android:text="MW"
                            android:textColor="@color/profile_avatar_text"
                            android:textSize="28sp"
                            android:textStyle="bold" />

                        <ImageButton
                            android:id="@+id/btnChangeAvatar"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="bottom|end"
                            android:background="@drawable/bg_camera_badge"
                            android:padding="5dp"
                            android:contentDescription="@string/change_photo"
                            app:srcCompat="@drawable/ic_baseline_camera_alt_24"
                            app:tint="@color/profile_camera_badge_icon" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Miriam Wanjohi"
                        android:textColor="@color/profile_header_text"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvEmailHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="miriam@example.com"
                        android:textColor="@color/profile_header_text_secondary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvMemberSince"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Member since May 2026"
                        android:textColor="@color/profile_header_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </FrameLayout>

            <!-- ── Your Journey stats ── -->
            <TextView
                style="@style/ProfileSectionHeader"
                android:layout_marginTop="20dp"
                android:text="@string/your_journey" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="10dp">

                <LinearLayout
                    style="@style/ProfileStatCard"
                    android:layout_marginEnd="8dp">
                    <TextView
                        android:id="@+id/tvStreakValue"
                        style="@style/ProfileStatValue"
                        android:textColor="@color/stat_streak_color"
                        android:text="25" />
                    <TextView style="@style/ProfileStatLabel" android:text="@string/days_streak" />
                </LinearLayout>

                <LinearLayout
                    style="@style/ProfileStatCard"
                    android:layout_marginEnd="8dp">
                    <TextView
                        android:id="@+id/tvReadValue"
                        style="@style/ProfileStatValue"
                        android:textColor="@color/stat_read_color"
                        android:text="142" />
                    <TextView style="@style/ProfileStatLabel" android:text="@string/read" />
                </LinearLayout>

                <LinearLayout style="@style/ProfileStatCard">
                    <TextView
                        android:id="@+id/tvFavoritesValue"
                        style="@style/ProfileStatValue"
                        android:textColor="@color/stat_favorites_color"
                        android:text="18" />
                    <TextView style="@style/ProfileStatLabel" android:text="@string/favorites" />
                </LinearLayout>
            </LinearLayout>

            <!-- ── Account Information ── -->
            <TextView
                style="@style/ProfileSectionHeader"
                android:layout_marginTop="20dp"
                android:text="@string/account_information" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="10dp">

                <!-- Full Name -->
                <LinearLayout
                    style="@style/ProfileRowItem">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView style="@style/ProfileRowLabel" android:text="@string/full_name" />
                        <TextView
                            android:id="@+id/tvFullNameValue"
                            style="@style/ProfileRowValue"
                            android:text="Miriam Wanjohi" />
                    </LinearLayout>
                    <ImageButton
                        android:id="@+id/btnEditName"
                        style="@style/ProfileRowEditButton"
                        android:contentDescription="@string/edit_full_name" />
                </LinearLayout>

                <!-- Email -->
                <LinearLayout
                    style="@style/ProfileRowItem"
                    android:layout_marginTop="10dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView style="@style/ProfileRowLabel" android:text="@string/email" />
                        <TextView
                            android:id="@+id/tvEmailValue"
                            style="@style/ProfileRowValue"
                            android:text="miriam@example.com" />
                    </LinearLayout>
                    <ImageButton
                        android:id="@+id/btnEditEmail"
                        style="@style/ProfileRowEditButton"
                        android:contentDescription="@string/edit_email" />
                </LinearLayout>

                <!-- Password -->
                <LinearLayout
                    style="@style/ProfileRowItem"
                    android:layout_marginTop="10dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView style="@style/ProfileRowLabel" android:text="@string/password" />
                        <TextView
                            android:id="@+id/tvPasswordValue"
                            style="@style/ProfileRowValue"
                            android:text="••••••••" />
                    </LinearLayout>
                    <ImageButton
                        android:id="@+id/btnEditPassword"
                        style="@style/ProfileRowEditButton"
                        android:contentDescription="@string/edit_password" />
                </LinearLayout>
            </LinearLayout>

            <!-- ── Achievements ── -->
            <TextView
                style="@style/ProfileSectionHeader"
                android:layout_marginTop="20dp"
                android:text="@string/achievements" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="10dp">

                <!-- 7-Day Streak (unlocked, gold) -->
                <LinearLayout
                    android:id="@+id/cardStreak"
                    style="@style/ProfileAchievementCard"
                    android:layout_marginEnd="8dp">
                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_achievement_gold"
                        android:padding="12dp"
                        app:srcCompat="@drawable/ic_baseline_local_fire_department_24"
                        app:tint="@color/achievement_gold_icon" />
                    <TextView
                        style="@style/ProfileAchievementTitle"
                        android:text="@string/achievement_streak_title" />
                    <TextView
                        style="@style/ProfileAchievementSubtitle"
                        android:text="@string/achievement_unlocked" />
                </LinearLayout>

                <!-- Bookworm (unlocked, purple) -->
                <LinearLayout
                    android:id="@+id/cardBookworm"
                    style="@style/ProfileAchievementCard"
                    android:layout_marginEnd="8dp">
                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_achievement_purple"
                        android:padding="12dp"
                        app:srcCompat="@drawable/ic_baseline_menu_book_24"
                        app:tint="@color/achievement_purple_icon" />
                    <TextView
                        style="@style/ProfileAchievementTitle"
                        android:text="@string/achievement_bookworm_title" />
                    <TextView
                        style="@style/ProfileAchievementSubtitle"
                        android:text="@string/achievement_bookworm_subtitle" />
                </LinearLayout>

                <!-- Year Journey (locked) -->
                <LinearLayout
                    android:id="@+id/cardYearJourney"
                    style="@style/ProfileAchievementCard">
                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_achievement_locked"
                        android:padding="12dp"
                        app:srcCompat="@drawable/ic_baseline_lock_24"
                        app:tint="@color/achievement_locked_icon" />
                    <TextView
                        style="@style/ProfileAchievementTitle"
                        android:textColor="@color/achievement_locked_text"
                        android:text="@string/achievement_year_title" />
                    <TextView
                        style="@style/ProfileAchievementSubtitle"
                        android:text="@string/achievement_year_subtitle" />
                </LinearLayout>
            </LinearLayout>

            <!-- ── Account Actions ── -->
            <TextView
                style="@style/ProfileSectionHeader"
                android:layout_marginTop="20dp"
                android:text="@string/account_actions" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="10dp">

                <Button
                    android:id="@+id/btnSignOut"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_button_outline"
                    android:drawableStart="@drawable/ic_baseline_logout_24"
                    android:drawablePadding="8dp"
                    android:drawableTint="@color/signout_button_text"
                    android:gravity="center"
                    android:text="@string/sign_out"
                    android:textAllCaps="false"
                    android:textColor="@color/signout_button_text"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnDeleteAccount"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_button_delete"
                    android:drawableStart="@drawable/ic_baseline_delete_24"
                    android:drawablePadding="8dp"
                    android:drawableTint="@color/delete_button_icon"
                    android:gravity="center"
                    android:text="@string/delete_account"
                    android:textAllCaps="false"
                    android:textColor="@color/delete_button_text"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>