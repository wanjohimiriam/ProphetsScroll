<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Dark theme overrides -->
    <style name="Theme.Prophets_Scroll" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/gold_primary</item>
        <item name="colorPrimaryVariant">@color/gold_dark</item>
        <item name="colorOnPrimary">@color/text_white</item>

        <item name="colorSecondary">@color/bronze</item>
        <item name="colorOnSecondary">@color/text_white</item>

        <item name="android:windowBackground">@color/home_background</item>
        <item name="android:statusBarColor">@color/home_background</item>
        <item name="android:navigationBarColor">@color/home_background</item>
        <item name="android:windowLightStatusBar">false</item>

        <item name="colorSurface">@color/feature_card_bg</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_hint</item>
        <item name="android:colorBackground">@color/home_background</item>
        <item name="colorOnBackground">@color/text_primary</item>

        <item name="colorError">@color/error_red</item>
        <item name="colorOnError">@color/text_white</item>

        <item name="actionBarStyle">@style/Prophets_Scroll.AppBar</item>
        <item name="bottomNavigationStyle">@style/Prophets_Scroll.BottomNav</item>
        <item name="materialCardViewStyle">@style/Prophets_Scroll.Card</item>
        <item name="materialButtonStyle">@style/Prophets_Scroll.Button</item>
    </style>

    <color name="home_background">#141414</color>
    <color name="feature_card_bg">#1E1E1E</color>
    <color name="card_border">#2A2A2A</color>
    <color name="text_primary">#FFFFFF</color>
    <color name="text_secondary">#B8B8B8</color>
    <color name="text_hint">#8A8A8A</color>

    <!-- Header banner -->
    <color name="profile_header_gradient_start">#6C5CE7</color>
    <color name="profile_header_gradient_end">#9C3FA8</color>
    <color name="profile_avatar_bg">#33FFFFFF</color>
    <color name="profile_avatar_text">#FFFFFF</color>
    <color name="profile_camera_badge_bg">#FFFFFF</color>
    <color name="profile_camera_badge_icon">#2A1F0E</color>
    <color name="profile_header_text">#FFFFFF</color>
    <color name="profile_header_text_secondary">#D9FFFFFF</color>

    <!-- Stat cards -->
    <color name="stat_card_bg">#1E1E1E</color>
    <color name="stat_card_border">#2A2A2A</color>
    <color name="stat_streak_color">#4FA8FF</color>
    <color name="stat_read_color">#66BB6A</color>
    <color name="stat_favorites_color">#FFB74D</color>

    <!-- Account Information rows -->
    <color name="row_item_bg">#1E1E1E</color>
    <color name="row_item_border">#2A2A2A</color>
    <color name="row_edit_icon">#B8B8B8</color>

    <!-- Achievement wells -->
    <color name="achievement_card_bg">#1E1E1E</color>
    <color name="achievement_card_border">#2A2A2A</color>
    <color name="achievement_gold_bg">#FFC107</color>
    <color name="achievement_gold_icon">#2A1F0E</color>
    <color name="achievement_purple_bg">#6C5CE7</color>
    <color name="achievement_purple_icon">#FFFFFF</color>
    <color name="achievement_locked_bg">#00000000</color>
    <color name="achievement_locked_border">#444444</color>
    <color name="achievement_locked_icon">#8A8A8A</color>
    <color name="achievement_locked_text">#8A8A8A</color>

    <!-- Account Action buttons -->
    <color name="signout_button_bg">#1E1E1E</color>
    <color name="signout_button_border">#3A3A3A</color>
    <color name="signout_button_text">#FFFFFF</color>

    <color name="delete_button_bg">#3D1E1E</color>
    <color name="delete_button_text">#EF5350</color>
    <color name="delete_button_icon">#EF5350</color>

</resources>